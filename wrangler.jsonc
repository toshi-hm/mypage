// Cloudflare Workers (static assets) 配信設定。
// 本番: https://toshi-page.mayabase.workers.dev
// ローカル確認: bun run preview:cf
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "toshi-page",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
}
