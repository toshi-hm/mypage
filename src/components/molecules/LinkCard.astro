---
import ExternalLink from "../atoms/ExternalLink.astro";
interface Props { title: string; href: string; description?: string; }
const { title, href, description } = Astro.props;
const isExternal = /^https?:\/\//.test(href);
---

{isExternal ? <ExternalLink class="link-card" href={href} label={title}>
  <span class="copy"><strong>{title}</strong>{description && <small>{description}</small>}</span>
  <span class="arrow" aria-hidden="true">↗</span>
</ExternalLink> : <a class="link-card" href={href}>
  <span class="copy"><strong>{title}</strong>{description && <small>{description}</small>}</span>
  <span class="arrow" aria-hidden="true">→</span>
</a>}

<style>
  :global(.link-card) { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.2rem 1.35rem; border: 1px solid var(--color-border); border-radius: var(--radius); background: var(--color-surface); color: var(--color-text); text-decoration: none; box-shadow: var(--shadow-sm); transition: border-color .2s ease, transform .2s ease; }
  :global(.link-card:hover) { border-color: var(--color-accent); transform: translateX(4px); }
  :global(.link-card .copy) { display: grid; gap: .15rem; }
  :global(.link-card strong) { font-size: 1.05rem; }
  :global(.link-card small) { color: var(--color-text-muted); }
  :global(.link-card .arrow) { display: grid; place-items: center; flex: none; width: 2.4rem; aspect-ratio: 1; border-radius: 50%; background: var(--color-highlight); color: var(--color-on-highlight); font-weight: 800; }
</style>
