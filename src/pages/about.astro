---
import { getCollection } from "astro:content";
import CareerItem from "../components/molecules/CareerItem.astro";
import ExternalLink from "../components/atoms/ExternalLink.astro";
import SectionHeading from "../components/molecules/SectionHeading.astro";
import SkillList from "../components/molecules/SkillList.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { sortCareer } from "../utils/career";
const simpleIconsCdn = "https://cdn.jsdelivr.net/npm/simple-icons@v16/icons";
const simpleIcon = (slug: string) => `${simpleIconsCdn}/${slug}.svg`;
const lobeIconsCdn = "https://unpkg.com/@lobehub/icons-static-svg@1.91.0/icons";
const lobeIcon = (slug: string) => `${lobeIconsCdn}/${slug}.svg`;
const skills = [
  { name: "TypeScript", iconUrl: simpleIcon("typescript"), fallback: "TS" },
  { name: "React", iconUrl: simpleIcon("react"), fallback: "RE", featured: true },
  { name: "LIFF", iconUrl: simpleIcon("line"), fallback: "LIFF" },
  { name: "Next.js", iconUrl: simpleIcon("nextdotjs"), fallback: "NX" },
  { name: "Vue.js", iconUrl: simpleIcon("vuedotjs"), fallback: "VUE", featured: true },
  { name: "Nuxt", iconUrl: simpleIcon("nuxt"), fallback: "NUX" },
  { name: "Astro.js", iconUrl: simpleIcon("astro"), fallback: "AST" },
  { name: "Node.js", iconUrl: simpleIcon("nodedotjs"), fallback: "NODE" },
  { name: "Express.js", iconUrl: simpleIcon("express"), fallback: "EXP" },
  { name: "Hono", iconUrl: simpleIcon("hono"), fallback: "HONO" },
  { name: "Bun", iconUrl: simpleIcon("bun"), fallback: "BUN" },
  { name: "Prisma", iconUrl: simpleIcon("prisma"), fallback: "PR" },
  { name: "Supabase", iconUrl: simpleIcon("supabase"), fallback: "SUPA" },
  { name: "MySQL", iconUrl: simpleIcon("mysql"), fallback: "SQL" },
  { name: "SCSS", iconUrl: simpleIcon("sass"), fallback: "SCSS" },
  { name: "CSS Modules", iconUrl: simpleIcon("cssmodules"), fallback: "CSSM" },
  { name: "Tailwind", iconUrl: simpleIcon("tailwindcss"), fallback: "TW" },
  { name: "Storybook", iconUrl: simpleIcon("storybook"), fallback: "SB" },
  { name: "Vitest", iconUrl: simpleIcon("vitest"), fallback: "VI" },
  {
    name: "Playwright",
    iconUrl:
      "https://cdn.jsdelivr.net/gh/devicons/devicon@v2.17.0/icons/playwright/playwright-original.svg",
    fallback: "PW",
  },
  {
    name: "Codex",
    iconUrl: lobeIcon("codex-color"),
    fallback: "CX",
  },
  { name: "Claude Code", iconUrl: lobeIcon("claudecode-color"), fallback: "CC" },
];
const career = sortCareer(await getCollection("career"));
const education = career.filter((item) => item.data.track === "education");
const work = career.filter((item) => item.data.track === "work");
const parallelStartDate = education.find((educationEntry) =>
  work.some((workEntry) => workEntry.data.startDate === educationEntry.data.startDate),
)?.data.startDate;
const parallelEducation = parallelStartDate
  ? education.filter((entry) => entry.data.startDate === parallelStartDate)
  : education;
const previousEducation = parallelStartDate
  ? education.filter((entry) => entry.data.startDate !== parallelStartDate)
  : [];
const now = new Date();
const initialVisitDate = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}`;
const initialVisitLabel = initialVisitDate.replaceAll("-", ".");
const formatMonthLabel = (month: string) => month.replace("-", ".");
const currentMonth = initialVisitDate.slice(0, 7);
const monthNumber = (month: string) => {
  const [year, monthValue] = month.split("-").map(Number);
  return year * 12 + monthValue;
};
const timelineStartMonth = Math.min(...career.map((entry) => monthNumber(entry.data.startDate)));
const timelineEndMonth = Math.max(
  monthNumber(currentMonth),
  ...career.map((entry) => monthNumber(entry.data.endDate ?? currentMonth)),
);
const timelineSpan = Math.max(timelineEndMonth - timelineStartMonth, 1);
const timelinePosition = (month: string) =>
  ((timelineEndMonth - monthNumber(month)) / timelineSpan) * 100;
const timelineEvents = [
  ...new Set(
    career.flatMap((entry) =>
      [entry.data.startDate, entry.data.endDate].filter((date): date is string => Boolean(date)),
    ),
  ),
].toSorted((a, b) => monthNumber(b) - monthNumber(a));
const timelinePeriods = career.map((entry) => ({
  startDate: entry.data.startDate,
  endDate: entry.data.endDate ?? currentMonth,
  startPosition: timelinePosition(entry.data.startDate),
  endPosition: timelinePosition(entry.data.endDate ?? currentMonth),
}));
---

<BaseLayout
  title="About"
  description="Hama Toshiya のプロフィール"
  keywords={["Hama Toshiya", "プロフィール", "フロントエンドエンジニア", "TypeScript", "React", "Vue.js"]}
>
  <section class="about-intro" aria-labelledby="about-intro-heading">
    <div class="about-intro-photo">
      <div class="about-intro-photo-frame">
        <img
          src="/images/profile.webp"
          alt="濱俊也のプロフィール写真"
          width="1200"
          height="1200"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <p class="about-intro-photo-caption mono">PROFILE / 2026</p>
    </div>
    <div class="about-intro-copy">
      <p class="eyebrow">About me</p>
      <h1 id="about-intro-heading">日常を少し便利にする、プロダクトをつくる。</h1>
      <p class="about-intro-name"><strong>濱 俊也</strong><span class="mono">Hama Toshiya</span></p>
      <div class="about-intro-description">
        <p>
          メガベンチャーでフロントエンドエンジニアとシステムプランナーを担当しています。要件定義から保守運用まで、一連のBtoCプロダクト開発に取り組んでいます。
        </p>
        <p>
          新卒入社と同時に大学院に入学し、人工知能科学を専攻。2026年3月に修士（人工知能科学）を取得しました。生成AIを理論的に学びつつ、業務でも実用的に活用しています。
        </p>
      </div>
      <nav class="social-links" aria-label="ソーシャルリンク">
        <ExternalLink href="https://github.com/toshi-hm" label="GitHub"
          ><span class="mono">GitHub</span><span aria-hidden="true">↗</span></ExternalLink
        >
        <ExternalLink href="https://www.linkedin.com/in/toshiyahama" label="LinkedIn"
          ><span class="mono">LinkedIn</span><span aria-hidden="true">↗</span></ExternalLink
        >
      </nav>
    </div>
  </section>
  <div class="profile-grid">
    <section aria-labelledby="skills-heading">
      <SectionHeading id="skills-heading" index="01" title="Skills" /><SkillList skills={skills} />
    </section>
    <aside>
      <p class="eyebrow">Currently</p><p>
        TypeScript をベースに、React・Vue.js
        を中心としたフロントエンド開発・設計を中心に行っています。
      </p>
    </aside>
  </div>
  {
    career.length > 0 && (
      <section class="career-section" aria-labelledby="career-heading">
        <SectionHeading id="career-heading" index="02" title="Career" />
        <p class="career-lead">
          理学から人工知能科学へ学びを広げながら、ソフトウェアエンジニアとしてプロダクト開発に取り組んできました。
        </p>
        <div class="career-timeline">
          <div class="timeline-rail" aria-hidden="true">
            {timelinePeriods.map((period) => (
              <span
                class="timeline-period"
                data-start-date={period.startDate}
                data-end-date={period.endDate}
                style={`--period-top: ${period.endPosition}%; --period-height: ${period.startPosition - period.endPosition}%;`}
              />
            ))}
            {timelineEvents.map((eventDate) => (
              <span
                class="timeline-event"
                data-date={eventDate}
                style={`--event-position: ${timelinePosition(eventDate)}%;`}
              />
            ))}
          </div>
          <div class="visit-marker">
            <span class="visit-label mono">SITE VISIT</span>
            <time class="visit-date mono" datetime={initialVisitDate}>
              {initialVisitLabel}
            </time>
            <small>今日まで続くキャリア</small>
          </div>

          <div class="timeline-row parallel-row">
            {parallelEducation.length > 0 && (
              <div class="timeline-entry education-entry">
                <p class="lane-label">
                  <span aria-hidden="true">02</span> Education
                </p>
                <div class="career-stack">
                  {parallelEducation.map((entry) => (
                    <CareerItem
                      role={entry.data.role}
                      organization={entry.data.organization}
                      track={entry.data.track}
                      startDate={entry.data.startDate}
                      endDate={entry.data.endDate}
                      description={entry.data.description}
                      highlights={entry.data.highlights}
                    />
                  ))}
                </div>
              </div>
            )}
            {work.length > 0 && (
              <div class="timeline-entry work-entry">
                <p class="lane-label">
                  <span aria-hidden="true">01</span> Job
                </p>
                <div class="career-stack">
                  {work.map((entry) => (
                    <CareerItem
                      role={entry.data.role}
                      organization={entry.data.organization}
                      track={entry.data.track}
                      startDate={entry.data.startDate}
                      endDate={entry.data.endDate}
                      description={entry.data.description}
                      highlights={entry.data.highlights}
                    />
                  ))}
                </div>
              </div>
            )}
            {parallelStartDate && (
              <div class="parallel-marker" role="note">
                <span class="mono">{formatMonthLabel(parallelStartDate)}</span>
                <strong>複数のキャリアを並行して開始</strong>
                <small>Education × Job</small>
              </div>
            )}
            {previousEducation.length > 0 && (
              <div class="timeline-entry education-previous-entry">
                <div class="career-stack">
                  {previousEducation.map((entry) => (
                    <CareerItem
                      role={entry.data.role}
                      organization={entry.data.organization}
                      track={entry.data.track}
                      startDate={entry.data.startDate}
                      endDate={entry.data.endDate}
                      description={entry.data.description}
                      highlights={entry.data.highlights}
                    />
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<script>
  const visitDate = document.querySelector<HTMLTimeElement>(".visit-date");
  if (visitDate) {
    const now = new Date();
    const year = String(now.getFullYear());
    const month = String(now.getMonth() + 1).padStart(2, "0");
    const day = String(now.getDate()).padStart(2, "0");
    visitDate.dateTime = `${year}-${month}-${day}`;
    visitDate.textContent = `${year}.${month}.${day}`;
  }

  const careerTimeline = document.querySelector<HTMLElement>(".career-timeline");
  const timelineRail = careerTimeline?.querySelector<HTMLElement>(".timeline-rail");
  const getEdge = (element: HTMLElement | null, edge: "top" | "bottom") => {
    if (!element) return null;
    const rect = element.getBoundingClientRect();
    return rect[edge];
  };
  if (careerTimeline && timelineRail) {
    const getCard = (selector: string) =>
      careerTimeline.querySelector<HTMLElement>(`${selector} .career-item`);

    const syncTimelineGeometry = () => {
      const railRect = timelineRail.getBoundingClientRect();
      const workCard = getCard(".work-entry");
      const graduateCard = getCard(".education-entry");
      const collegeCard = getCard(".education-previous-entry");
      const parallelStart = [getEdge(workCard, "bottom"), getEdge(graduateCard, "bottom")]
        .filter((edge): edge is number => edge !== null)
        .reduce((edge, nextEdge) => Math.max(edge, nextEdge), railRect.top);
      const eventEdges = new Map<string, number>();
      const setEventEdge = (date: string, edge: number | null) => {
        if (edge !== null) eventEdges.set(date, edge);
      };
      setEventEdge("2026-03", getEdge(graduateCard, "top"));
      setEventEdge("2024-04", parallelStart);
      setEventEdge("2024-03", getEdge(collegeCard, "top"));
      setEventEdge("2020-04", getEdge(collegeCard, "bottom"));
      eventEdges.set(
        `${new Date().getFullYear()}-${String(new Date().getMonth() + 1).padStart(2, "0")}`,
        railRect.top,
      );

      careerTimeline.querySelectorAll<HTMLElement>(".timeline-event").forEach((event) => {
        const edge = eventEdges.get(event.dataset.date ?? "");
        if (edge !== undefined && edge !== null) {
          event.style.setProperty("--event-position", `${edge - railRect.top}px`);
        }
      });

      careerTimeline.querySelectorAll<HTMLElement>(".timeline-period").forEach((period) => {
        const startEdge = eventEdges.get(period.dataset.startDate ?? "");
        const endEdge = eventEdges.get(period.dataset.endDate ?? "");
        if (
          startEdge !== undefined &&
          startEdge !== null &&
          endEdge !== undefined &&
          endEdge !== null
        ) {
          period.style.setProperty("--period-top", `${endEdge - railRect.top}px`);
          period.style.setProperty("--period-height", `${Math.max(startEdge - endEdge, 0)}px`);
        }
      });
    };

    syncTimelineGeometry();
    window.addEventListener("resize", syncTimelineGeometry);
    document.fonts?.ready.then(syncTimelineGeometry);
  }
</script>

<style>
  .about-intro {
    position: relative;
    display: grid;
    grid-template-columns: minmax(13rem, 0.55fr) minmax(0, 1.45fr);
    gap: clamp(1.5rem, 5vw, 4.5rem);
    align-items: center;
    margin: 0 0 clamp(2rem, 4vw, 3rem);
    padding: clamp(1.25rem, 3vw, 2.5rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg) var(--radius-lg) var(--radius-sm) var(--radius-lg);
    background: color-mix(in srgb, var(--color-surface) 76%, transparent);
    box-shadow: var(--shadow-sm);
    isolation: isolate;
  }
  .about-intro::before {
    content: "";
    position: absolute;
    z-index: -1;
    top: 1.25rem;
    left: 1.25rem;
    width: min(24vw, 17rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-highlight-soft);
    transform: translate(-1.5rem, -1.5rem);
  }
  .about-intro-photo {
    position: relative;
    width: 100%;
    max-width: 18rem;
    margin: 0 auto;
  }
  .about-intro-photo-frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1;
    border: 0.55rem solid var(--color-surface);
    border-radius: 48% 52% 45% 55% / 46% 44% 56% 54%;
    box-shadow: var(--shadow-lg);
    transform: rotate(-2deg);
  }
  .about-intro-photo-frame::after {
    content: "";
    position: absolute;
    inset: 0;
    border: 1px solid rgb(255 255 255 / 45%);
    border-radius: inherit;
    pointer-events: none;
  }
  .about-intro-photo-frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .about-intro-photo-caption {
    position: absolute;
    right: -0.5rem;
    bottom: -1.1rem;
    margin: 0;
    padding: 0.45rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    box-shadow: var(--shadow-sm);
    transform: rotate(3deg);
  }
  .about-intro-copy {
    min-width: 0;
  }
  .about-intro-copy h1 {
    margin: 0.75rem 0 1rem;
    font-size: clamp(1.8rem, 3.5vw, 3rem);
  }
  .about-intro-name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.85rem;
    margin: 0;
  }
  .about-intro-name strong {
    color: var(--color-accent);
    font-size: 1.2rem;
  }
  .about-intro-name span {
    color: var(--color-text-muted);
    font-size: 0.78rem;
    font-weight: 700;
  }
  .about-intro-description {
    margin-top: 1.25rem;
    color: var(--color-text-muted);
  }
  .about-intro-description p {
    margin: 0;
  }
  .about-intro-description p + p {
    margin-top: 0.75rem;
  }
  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.5rem 0 0;
  }
  .social-links :global(.external-link) {
    display: inline-flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 3rem;
    padding: 0.55rem 0.75rem 0.55rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text);
    font-size: 0.8rem;
    font-weight: 750;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
  }
  .social-links :global(.external-link) span:last-child {
    display: grid;
    place-items: center;
    width: 1.8rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-highlight);
    color: var(--color-on-highlight);
  }
  .social-links :global(.external-link:hover) {
    border-color: var(--color-accent);
    color: var(--color-accent);
    transform: translateY(-2px);
  }
  .profile-grid {
    display: grid;
    grid-template-columns: 1fr minmax(15rem, 0.45fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: end;
  }
  .profile-grid :global(.heading) {
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  aside {
    padding: 1.5rem;
    border-radius: var(--radius) var(--radius) var(--radius-sm) var(--radius);
    background: var(--color-highlight-soft);
    transform: rotate(1deg);
  }
  aside p:last-child {
    margin: 0;
    font-weight: 650;
  }
  .career-section {
    position: relative;
  }
  .career-lead {
    margin: 0 0 2rem;
    color: var(--color-text-muted);
    font-size: 1.05rem;
  }
  .career-timeline {
    position: relative;
    display: grid;
    gap: 2.5rem;
    padding: 1.25rem 0 1rem;
  }
  .career-timeline::before {
    content: "";
    position: absolute;
    z-index: 0;
    top: 0.7rem;
    bottom: 0;
    left: 50%;
    width: 2px;
    background: linear-gradient(
      to bottom,
      var(--color-accent),
      color-mix(in srgb, var(--color-accent) 45%, var(--color-border)) 68%,
      var(--color-border)
    );
    transform: translateX(-50%);
  }
  .timeline-rail {
    position: absolute;
    z-index: 2;
    top: 0.7rem;
    right: 0;
    bottom: 0;
    left: 0;
    pointer-events: none;
  }
  .timeline-period {
    position: absolute;
    top: var(--period-top);
    left: 50%;
    width: 0.55rem;
    height: var(--period-height);
    border-radius: 999px;
    background: var(--color-accent);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-surface) 60%, transparent);
    transform: translateX(-50%);
  }
  .timeline-event {
    position: absolute;
    top: var(--event-position);
    left: 50%;
    width: 0.9rem;
    aspect-ratio: 1;
    border: 2px solid var(--color-surface);
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: var(--shadow-sm);
    transform: translate(-50%, -50%);
  }
  .career-timeline::after {
    content: "";
    position: absolute;
    top: 0.25rem;
    left: 50%;
    width: 0.7rem;
    height: 0.7rem;
    border: solid var(--color-accent);
    border-width: 2px 0 0 2px;
    transform: translateX(-50%) rotate(45deg);
  }
  .visit-marker {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: auto auto;
    align-items: center;
    gap: 0.15rem 0.75rem;
    width: fit-content;
    margin: 0 auto 2rem;
    padding: 0.8rem 1.1rem;
    border: 1px solid var(--color-accent);
    border-radius: var(--radius);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }
  .visit-marker::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 50%;
    height: 2rem;
    border-left: 2px solid var(--color-accent);
    transform: translateX(-50%);
  }
  .visit-label {
    color: var(--color-accent);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }
  .visit-date {
    font-size: 0.9rem;
    font-weight: 850;
  }
  .visit-marker small {
    grid-column: 1 / -1;
    color: var(--color-text-muted);
    font-size: 0.7rem;
    text-align: center;
  }
  .parallel-marker {
    grid-area: marker;
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: center;
    gap: 0.8rem 1rem;
    width: fit-content;
    max-width: 100%;
    margin: 0 auto;
    padding: 0.8rem 1.2rem;
    border: 1px solid color-mix(in srgb, var(--color-highlight) 65%, var(--color-border));
    border-radius: 999px;
    background: var(--color-highlight);
    color: var(--color-on-highlight);
    box-shadow: var(--shadow-sm);
  }
  .parallel-marker .mono {
    font-size: 0.72rem;
    font-weight: 800;
  }
  .parallel-marker strong {
    font-size: 0.88rem;
  }
  .parallel-marker small {
    color: color-mix(in srgb, var(--color-on-highlight) 72%, transparent);
    font-size: 0.75rem;
  }
  .timeline-row {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas:
      "work education"
      "marker marker"
      ". education-previous";
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
  }
  .timeline-entry {
    min-width: 0;
  }
  .career-stack {
    display: grid;
    gap: 1.25rem;
  }
  .parallel-row > .timeline-entry:not(.education-previous-entry) {
    align-self: stretch;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
  }
  .parallel-row > .timeline-entry:not(.education-previous-entry) .career-stack {
    align-content: end;
  }
  .education-entry {
    grid-area: education;
  }
  .work-entry {
    grid-area: work;
  }
  .education-previous-entry {
    grid-area: education-previous;
  }
  .lane-label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.75rem;
    color: var(--color-accent);
    font: 800 0.76rem/1.4 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .lane-label span {
    display: grid;
    place-items: center;
    width: 1.75rem;
    aspect-ratio: 1;
    border-radius: 50%;
